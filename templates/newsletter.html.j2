<!DOCTYPE html>
<html lang="{{ lang | default('de') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
</head>
<!-- Pre-Header: erscheint als Vorschau-Zeile im Postfach, im Body versteckt -->
<body style="margin:0; padding:0; background-color:#f4f4f4; font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;">
  <span style="display:none; max-height:0; overflow:hidden;">{{ preheader | default(title) }}</span>

  <!-- Äußere Tabelle: zentriert den Inhalt -->
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;">
    <tr>
      <td align="center" style="padding:24px 12px;">

        <!-- Inhalts-Container: feste max-width ~600px -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:8px; overflow:hidden;">
          <tr>
            <td style="padding:32px;">
              <h1 style="margin:0 0 16px; font-size:24px; line-height:1.3; color:#111111;">{{ title }}</h1>

              {% for section in sections | default([{'heading':'Abschnitt', 'body':'Inhalt …'}]) %}
              <h2 style="margin:24px 0 8px; font-size:18px; color:#222222;">{{ section.heading }}</h2>
              <p style="margin:0 0 16px; font-size:16px; line-height:1.6; color:#444444;">{{ section.body }}</p>
              {% endfor %}

              <!-- Genau ein CTA -->
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
                <tr>
                  <td style="background-color:#2563eb; border-radius:6px;">
                    <a href="{{ cta_url | default('#') }}" style="display:inline-block; padding:12px 24px; font-size:16px; color:#ffffff; text-decoration:none;">{{ cta_label | default('Mehr erfahren') }}</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:16px 32px; background-color:#fafafa; font-size:12px; color:#999999;">
              {{ footer | default('Abmelden · Impressum') }}
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>
